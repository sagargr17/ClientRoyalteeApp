# Base URL of the tenant API (per-tenant subdomain), e.g. https://hungry.yourapp.com
NEXT_PUBLIC_API_BASE_URL=https://hungry.localhost:8000

# Set to "true" to browse the whole app with fake data — no backend needed.
# Verify screen: card code is prefilled, any 4-digit PIN works.
NEXT_PUBLIC_MOCK_MODE=true
